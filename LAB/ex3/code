
#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char s[1000];
    int i = 0;

    printf("Enter a C statement:\n");
    fgets(s, sizeof(s), stdin);

    while (s[i] != '\0') {
        if (isspace(s[i])) {
            i++;
        }
        else if (s[i] == '/' && s[i + 1] == '/') {
            break;
        }
        else if (s[i] == '/' && s[i + 1] == '*') {
            i += 2;
            while (s[i] && !(s[i] == '*' && s[i + 1] == '/'))
                i++;
            if (s[i]) i += 2;
        }
        else if (isalpha(s[i]) || s[i] == '_') {
            printf("Identifier: ");
            while (isalnum(s[i]) || s[i] == '_')
                printf("%c", s[i++]);
            printf("\n");
        }
        else if (isdigit(s[i])) {
            printf("Constant: ");
            while (isdigit(s[i]) || s[i] == '.')
                printf("%c", s[i++]);
            printf("\n");
        }
        else if (strchr("+-*/%=<>!&|^", s[i])) {
            printf("Operator: %c\n", s[i++]);
        }
        else {
            i++;
        }
    }

    return 0;
}

