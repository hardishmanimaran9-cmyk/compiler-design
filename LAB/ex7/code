#include <stdio.h>

int main() {
    char ch;
    int spaces = 0, newlines = 0;

    printf("Enter text (press Ctrl+D on Linux or Ctrl+Z then Enter on Windows to stop):\n");

    while ((ch = getchar()) != EOF) {
        if (ch == ' ')
            spaces++;
        else if (ch == '\n')
            newlines++;
    }

    printf("Whitespaces: %d\n", spaces);
    printf("Newlines: %d\n", newlines);

    return 0;
}
