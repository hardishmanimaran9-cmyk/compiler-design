#include <stdio.h>
#include <string.h>

int main() {
    char A, alpha[50], beta[50];

    printf("Enter Non-Terminal: ");
    scanf(" %c", &A);

    printf("Enter alpha (recursive part): ");
    scanf("%s", alpha);

    printf("Enter beta (non-recursive part): ");
    scanf("%s", beta);

    printf("\nAfter Eliminating Left Recursion:\n");
    printf("%c -> %s%c'\n", A, beta, A);
    printf("%c' -> %s%c' | e\n", A, alpha, A);

    return 0;
}
