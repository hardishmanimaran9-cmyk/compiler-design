#include <stdio.h>
#include <string.h>

int main() {
    char a[50], b[50];
    int i = 0;

    printf("Enter first production: ");
    scanf("%s", a);

    printf("Enter second production: ");
    scanf("%s", b);

    while (a[i] == b[i] && a[i] != '\0')
        i++;

    if (i == 0) {
        printf("No common prefix found");
    } else {
        printf("\nAfter Left Factoring:\n");
        printf("S -> %.*sS'\n", i, a);
        printf("S' -> %s | %s\n", a+i, b+i);
    }

    return 0;
}
