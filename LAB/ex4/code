```c
#include <stdio.h>
#include <string.h>

int main() {
    char s[1000];

    printf("Enter a line: ");
    fgets(s, sizeof(s), stdin);

    if (strncmp(s, "//", 2) == 0)
        printf("It is a single-line comment");
    else if (strncmp(s, "/*", 2) == 0 && strstr(s, "*/") != NULL)
        printf("It is a multi-line comment");
    else
        printf("It is not a comment");

    return 0;
}
